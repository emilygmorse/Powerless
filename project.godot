[internationalization]

locale/translations_pot_files=PackedStringArray("res://dialogue/test.dialogue")

[layer_names]

2d_render/layer_1="Ingame"
2d_render/layer_2="UI"
2d_physics/layer_1="Player"
2d_physics/layer_2="Teddy"
2d_physics/layer_3="Enemy"
2d_physics/layer_4="Light"
2d_physics/layer_5="Walls"
2d_physics/layer_6="interactions"
2d_physics/layer_7="Teddy Attack"
2d_physics/layer_8="Clickables"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
