; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Powerless"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://images/icon.png"

[autoload]

SignalManager="*res://singletons/signal_manager.gd"
GameManager="*res://singletons/game_manager.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
KeyPersistence="*res://menus/options/KeyPersistence.gd"

[dialogue_manager]

general/custom_test_scene_path="res://dialogue/test_dialogue.tscn"
general/balloon_path="res://dialogue/balloon.tscn"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[global_group]

Enemy=""
Player=""
Light=""
"Teddy Attack"=""

